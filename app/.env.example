# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). Both must be set for
# the app to use the real backend — leave them unset to keep running on
# the mock/demo adapter (see src/lib/dataClient.js).
#
# In this remote session specifically: don't paste real values into chat.
# Add them as environment variables in the session/environment settings
# instead, under these exact names, then start a new session so they load.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
